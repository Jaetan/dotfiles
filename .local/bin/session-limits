#!/usr/bin/env bash
# Run a command, and everything it starts, in a transient systemd user scope under claude.slice, which holds it to
# CPUs 0-19 and caps its memory, so a runaway process is killed inside the session instead of taking the WSL VM down.
#
#   session-limits COMMAND [ARGS...]      e.g. session-limits claude --resume
#
# The caps live on the slice (~/.config/systemd/user/claude.slice), not on this scope, because each call Claude Code
# runs gets a scope of its own under the same slice and a scope is a leaf. The kernel enforces AllowedCPUs only when
# the user manager is delegated the cpuset controller. OOMPolicy=continue kills only the process that exceeds the cap,
# not the whole session. Without the slice's caps in force this refuses to start: an absent slice would be created
# empty, with no cap at all.
set -euo pipefail

slice=claude.slice
cpus=0-19

if [ "$#" -eq 0 ]; then
    echo "usage: session-limits COMMAND [ARGS...]" >&2
    exit 2
fi

state="$(systemctl --user is-system-running 2>/dev/null || true)"
if [ "$state" != running ] && [ "$state" != degraded ]; then
    echo "session-limits: no systemd user manager ($state): no memory cap; CPUs held by affinity only." >&2
    exec taskset -c "$cpus" "$@"
fi

delegated="/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/cgroup.controllers"
if ! grep -qw cpuset "$delegated" 2>/dev/null; then
    echo "session-limits: the user manager has no cpuset controller: CPUs held by affinity only (a child can widen it)." >&2
fi

if [ "$(systemctl --user show -p MemoryMax --value "$slice")" = infinity ]; then
    echo "session-limits: $slice has no memory cap (unit missing or not loaded: systemctl --user daemon-reload)." >&2
    exit 1
fi

exec systemd-run --user --scope --quiet --collect --slice="$slice" -p OOMPolicy=continue \
    -- taskset -c "$cpus" "$@"
