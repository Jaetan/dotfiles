#!/home/nicolas/.local/bin/python3.14
"""Watch a pull request's checks, then end with pr-all-green's verdict, which is the exit status.

Usage: pr-checks-watch PR [--record PATH]

PR is the pull request's number in the repository of the working directory. The head is read first
(`gh pr view PR --json headRefOid`), then the watch runs: `gh pr checks PR --watch --fail-fast --interval 20`,
which ends at the first failed check or when every check has ended; its tables are kept in PATH when --record
names one and dropped otherwise. The watch only waits: the verdict is `pr-all-green PR --head HEAD`, the reading
a merge goes through, run from this script's own resolved directory with `--logs PATH.logs` when --record is
given, so a watch reads GREEN only where a merge would.

Printed on stdout, which the harness keeps as the task's own output: the head read before the watch, the
watch's status, then pr-all-green's answer as it comes, whose last line names the verdict. Exit 0 GREEN, 1 RED,
3 INCOMPLETE (nothing red, but something pending or absent, or the head moved), 2 UNREAD (gh could not be started,
for the view or for the watch, could not read the head, or answered no object with a non-empty string headRefOid;
or the record cannot be written, which is tried before the watch and again after it; or pr-all-green could not
answer, its message printed; a pr-all-green that cannot run or ends with a status outside 0 to 3 reads UNREAD, a
last line naming why), 4 on a usage error.

Why this script: a watch whose verdict is one line appended to a log behind a
`;` chain hands the harness the chain's last exit status, and a context that
reads the task's notification after a clear sees "exit code 0" over an empty
output and takes it for green (2026-10-15, a red coverage lane read as green).
pr-watch-guard.py, in the Claude Code hook kit, holds every watch to this
script and this script's status to the task's.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path
from typing import TYPE_CHECKING, NamedTuple, NewType, TypedDict

if TYPE_CHECKING:
    from collections.abc import Sequence

# A word of a command line; what gh printed; a commit's hash as GitHub spells it; a line printed; a pull
# request's number; a path as the command line spells it; a process's exit status (gh's, pr-all-green's or this
# script's).
Arg = NewType("Arg", str)
GhText = NewType("GhText", str)
Sha = NewType("Sha", str)
Line = NewType("Line", str)
PullNumber = NewType("PullNumber", int)
RecordPath = NewType("RecordPath", str)
ExitStatus = NewType("ExitStatus", int)
GREEN, RED, UNREAD, INCOMPLETE, USAGE = ExitStatus(0), ExitStatus(1), ExitStatus(2), ExitStatus(3), ExitStatus(4)

# The statuses of pr-all-green that are verdicts, this script's own; any other reads UNREAD.
VERDICTS = frozenset({GREEN, RED, UNREAD, INCOMPLETE})
VERDICT_SCRIPT = "pr-all-green"
WATCH_INTERVAL = "20"


class PullView(TypedDict):
    """What `gh pr view --json headRefOid` answers, its head read as a non-empty string."""

    headRefOid: Sha


class GhAnswer(NamedTuple):
    """What a gh call printed and how it ended."""

    out: GhText
    err: GhText
    status: ExitStatus


class Options(argparse.Namespace):
    """The command line, as parsed."""

    pull: PullNumber = PullNumber(0)
    record: RecordPath | None = None


def gh(*args: Arg) -> GhAnswer | Line:
    """Run gh with ``args`` and capture what it printed, or the line saying why gh could not be started."""
    try:
        done = subprocess.run(["gh", *args], capture_output=True, text=True, check=False)
    except OSError as exc:
        return Line(f"UNREAD: gh could not be started: {exc.strerror}")
    return GhAnswer(GhText(done.stdout), GhText(done.stderr), ExitStatus(done.returncode))


def view(pull: PullNumber) -> PullView | Line:
    """The pull request's head, or the line saying why gh named none."""
    answer = gh(Arg("pr"), Arg("view"), Arg(str(pull)), Arg("--json"), Arg("headRefOid"))
    if isinstance(answer, str):
        return answer
    if answer.status != 0:
        return Line(f"UNREAD: gh pr view {pull} ended with status {answer.status}: {answer.err.strip()}")
    try:
        answered = json.loads(answer.out)
    except json.JSONDecodeError as exc:
        return Line(f"UNREAD: gh pr view {pull} printed no JSON: {exc}")
    head = answered.get("headRefOid") if isinstance(answered, dict) else None
    if not isinstance(head, str):
        return Line(f"UNREAD: gh pr view {pull} answered no string headRefOid: {answer.out.strip()}")
    if not head:
        return Line(f"UNREAD: gh pr view {pull} answered an empty headRefOid")
    return {"headRefOid": Sha(head)}


def keep(record: RecordPath, text: GhText) -> Line | None:
    """Replace what ``record`` holds with ``text``: None, or the line naming the record and why it cannot be written."""
    try:
        with open(record, "w", encoding="utf-8") as kept:
            _ = kept.write(text)
    except OSError as exc:
        return Line(f"UNREAD: the record {record} cannot be written: {exc.strerror}")
    return None


def watch(pull: PullNumber, record: RecordPath | None) -> ExitStatus | Line:
    """Run gh's watch to its end and return its status, its tables kept in ``record`` where asked.

    The record is emptied before the watch, so one that cannot be written ends the run before the wait; that
    line, the one for a gh that cannot be started, or the one for a write that fails after the watch, is returned
    instead of the status.
    """
    if record is not None and (refused := keep(record, GhText(""))) is not None:
        return refused
    answer = gh(Arg("pr"), Arg("checks"), Arg(str(pull)), Arg("--watch"), Arg("--fail-fast"), Arg("--interval"),
                Arg(WATCH_INTERVAL))
    if isinstance(answer, str):
        return answer
    if record is not None and (refused := keep(record, GhText(answer.out + answer.err))) is not None:
        return refused
    return answer.status


def judge(pull: PullNumber, head: Sha, record: RecordPath | None) -> ExitStatus:
    """Run pr-all-green beside this script on ``head``, its output printed as it comes; its status as a verdict."""
    script = Path(__file__).resolve().with_name(VERDICT_SCRIPT)
    command = [str(script), str(pull), "--head", head]
    if record is not None:
        command += ["--logs", f"{record}.logs"]
    try:
        done = subprocess.run(command, check=False)
    except OSError as exc:
        print(f"UNREAD: {script} could not run: {exc.strerror}")
        return UNREAD
    if done.returncode in VERDICTS:
        return ExitStatus(done.returncode)
    print(f"UNREAD: {VERDICT_SCRIPT} ended with status {done.returncode}, which is no verdict")
    return UNREAD


def main(argv: Sequence[Arg] | None = None) -> ExitStatus:
    """Read the head, watch, then judge through pr-all-green, printing every line on stdout."""
    parser = argparse.ArgumentParser(prog="pr-checks-watch", description=(__doc__ or "").split("\n\n", maxsplit=1)[0])
    _ = parser.add_argument("pull", type=int, help="the pull request's number")
    _ = parser.add_argument("--record",
                            help="keep the watch's tables in this file, and pr-all-green's job logs in RECORD.logs")
    try:
        args = parser.parse_args(argv, namespace=Options())
    except SystemExit as exc:
        return USAGE if exc.code else GREEN
    record = args.record or None

    first = view(args.pull)
    if isinstance(first, str):
        print(first)
        return UNREAD
    head = first["headRefOid"]
    print(f"head {head} watched", flush=True)
    status = watch(args.pull, record)
    if isinstance(status, str):
        print(status)
        return UNREAD
    print(f"watch ended with status {status}", flush=True)
    return judge(args.pull, head, record)


if __name__ == "__main__":
    sys.exit(main())
