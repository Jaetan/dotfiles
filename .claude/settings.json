{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git remote:*)",
      "Bash(git stash list:*)"
    ],
    "defaultMode": "default"
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "advisorModel": "opus",
  "tui": "fullscreen",
  "editorMode": "normal",
  "autoScrollEnabled": true,
  "skipAutoPermissionPrompt": true
}
